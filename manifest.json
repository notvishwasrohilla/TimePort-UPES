{
  "manifest_version": 3,
  "name": "TimePort",
  "version": "0.6.1",
  "description": "Syncs your UPES academic timetable to Google Calendar.",
  "permissions": [
    "activeTab",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://myupes-beta.upes.ac.in/*",
    "https://tzxkpfitveofqkfcfkcz.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://myupes-beta.upes.ac.in/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://myupes-beta.upes.ac.in/*"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "887400701013-rlcudhl3sm36usbpckc9qp9d1nv0sgff.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "action": {
    "default_popup": "popup.html"
  }
}